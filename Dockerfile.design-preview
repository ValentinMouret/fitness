# syntax=docker/dockerfile:1.7
FROM oven/bun:1-alpine@sha256:819f91180e721ba09e0e5d3eb7fb985832fd23f516e18ddad7e55aaba8100be7 AS base
WORKDIR /app

FROM base AS build
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY . .
ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA
ENV NODE_ENV=production FITNESS_DESIGN_PREVIEW=true
RUN bun run build

FROM base AS runtime
RUN apk add --no-cache nodejs
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts
COPY --from=build --chown=bun:bun /app/build ./build
COPY --from=build --chown=bun:bun /app/server/request-logging.cjs ./server/request-logging.cjs
ENV NODE_ENV=production PORT=5174
USER bun
EXPOSE 5174
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.PORT + '/healthz').then(async r => { const v = await r.json(); if (!r.ok || v.status !== 'ok' || v.mode !== 'synthetic-design-preview') process.exit(1); }).catch(() => process.exit(1))"]
CMD ["node", "--require", "./server/request-logging.cjs", "./node_modules/@react-router/serve/bin.js", "./build/server/index.js"]
