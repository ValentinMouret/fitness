NODE_ENV=production
PORT=5174
DATABASE_URL=postgresql://valentin:password@localhost:5432/fitness
GIT_SHA=unknown
ANTHROPIC_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
AUTH_USERNAME=
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
AUTH_PASSWORD=

# Dokploy preview deployments only. Production should leave PREVIEW_APP unset.
PREVIEW_APP=false
REVIEW_DATABASE_ADMIN_URL=
REVIEW_DATABASE_SOURCE_URL=
REVIEW_DATABASE_URL_PREFIX=
REVIEW_DATABASE_RUN_SEED=true

# Optional remote MCP. Leave the issuer unset and clients empty to disable it.
# Use the public HTTPS origin, without a trailing slash.
# OAUTH_ISSUER_URL=https://fitness.example.com
OAUTH_CLIENTS=[]
# OAUTH_CLIENTS is a JSON array of {"name","id","secret","redirectUri"}.
# Copy the exact callback from each client setup; generate distinct secrets.
AUTH_SESSION_TTL_SECONDS=604800
OAUTH_CODE_TTL_SECONDS=300
OAUTH_ACCESS_TTL_SECONDS=900
OAUTH_REFRESH_TTL_SECONDS=2592000

# Dedicated SQL reader; provision after migrating. Never use the app database login.
# MCP_DATABASE_URL=postgresql://fitness_mcp_reader:password@localhost:5432/fitness
