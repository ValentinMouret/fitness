#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - unattended-upgrades
users:
  - name: fitness-deploy
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${jsonencode("restrict ${deploy_ssh_public_key}")}
write_files:
  - path: /etc/docker/daemon.json
    content: '{"log-driver":"local"}'
runcmd:
  - [usermod, -aG, docker, fitness-deploy]
  - [install, -d, -m, '0700', -o, fitness-deploy, -g, fitness-deploy, /srv/fitness]
  - [sh, -ec, 'fallocate -l 2G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && echo "/swapfile none swap sw 0 0" >> /etc/fstab']
  - [systemctl, restart, docker]
