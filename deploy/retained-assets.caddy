# Candidate only: import inside the production site after the retention gate
# is installed and seeded. See README.md; previews must not import this file.
@retained_assets {
    method GET HEAD
    path_regexp retained_assets ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|svg|jpg|webp)$
    file {
        root /srv/fitness/retained-production
        try_files {path}
    }
}
handle @retained_assets {
    root * /srv/fitness/retained-production
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
}
